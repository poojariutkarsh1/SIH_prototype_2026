<?xml version="1.0"?>

<robot name="lidar_ttc_bot">

  <!-- ========================= -->
  <!-- BASE                      -->
  <!-- ========================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="5.0"/>

      <inertia
        ixx="0.15"
        ixy="0.0"
        ixz="0.0"
        iyy="0.18"
        iyz="0.0"
        izz="0.25"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- LEFT WHEEL               -->
  <!-- ========================= -->

  <link name="left_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- RIGHT WHEEL              -->
  <!-- ========================= -->

  <link name="right_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>

      <inertia
        ixx="0.005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.005"
        iyz="0.0"
        izz="0.005"/>
    </inertial>

  </link>


  <!-- ========================= -->
  <!-- LEFT WHEEL JOINT          -->
  <!-- ========================= -->

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.25 0.12"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- RIGHT WHEEL JOINT         -->
  <!-- ========================= -->

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.25 0.12"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ========================= -->
  <!-- LIDAR LINK               -->
  <!-- ========================= -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </visual>

  </link>


  <!-- ========================= -->
  <!-- LIDAR JOINT              -->
  <!-- ========================= -->

  <joint name="lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.3"/>

  </joint>


  <!-- ========================= -->
  <!-- DIFFERENTIAL DRIVE       -->
  <!-- ========================= -->

  <gazebo>

    <plugin
      name="diff_drive"
      filename="libgazebo_ros_diff_drive.so">

      <ros>
        <namespace>/</namespace>
      </ros>

      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>

      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.5</wheel_separation>

      <wheel_diameter>0.24</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>

      <max_wheel_acceleration>10</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>

      <odometry_topic>odom</odometry_topic>

      <odometry_frame>odom</odometry_frame>

      <robot_base_frame>base_link</robot_base_frame>

    </plugin>

  </gazebo>


  <!-- ========================= -->
  <!-- LIDAR SENSOR              -->
  <!-- ========================= -->

  <gazebo reference="lidar_link">

    <sensor
      name="lidar_sensor"
      type="ray">

      <always_on>true</always_on>

      <update_rate>10</update_rate>

      <visualize>true</visualize>

      <ray>

        <scan>

          <horizontal>

            <samples>360</samples>

            <resolution>1</resolution>

            <min_angle>-3.14159</min_angle>

            <max_angle>3.14159</max_angle>

          </horizontal>

        </scan>

        <range>

          <min>0.12</min>

          <max>10.0</max>

          <resolution>0.01</resolution>

        </range>

      </ray>


      <!-- ========================= -->
      <!-- ROS 2 LiDAR PLUGIN        -->
      <!-- ========================= -->

      <plugin
        name="lidar_ros_plugin"
        filename="libgazebo_ros_ray_sensor.so">

        <ros>
          <namespace>/</namespace>
        </ros>

        <output_type>sensor_msgs/LaserScan</output_type>

        <frame_name>lidar_link</frame_name>

      </plugin>

    </sensor>

  </gazebo>


</robot>
